# Configurações do Banco de Dados Local (acessado de dentro do Docker)
# Renomeie este arquivo para .env e altere os valores conforme seu ambiente

# URL de conexão do Spring (se precisar mudar porta ou nome do banco)
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/nfora_prazo_dev

# Credenciais do Banco Local
DB_USER=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui

# Diretório de uploads dentro do container (manter padrão)
FILE_UPLOAD_DIR=/app/uploads

# Credenciais do Servidor de E-mail (Terra)
MAIL_HOST=smtp.terra.com.br
MAIL_PORT=587
MAIL_USER=seu-email@terra.com.br
MAIL_PASS=sua-senha
